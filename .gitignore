# 虚拟环境（302 MB，可由 run_all.sh 重建）
.venv/

# 分析工具缓存
.pytest_cache/
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
._*

# Office 临时/锁文件
.~*
~$*
*.tmp

# 编辑器
.vscode/
.idea/
*.swp

# 论文导出中间产物（HTML/DOCX 由 code/export_paper.py 生成，保留以便直接查看）
# 如需精简仓库，可取消下一行注释
# paper/export/*.html
# paper/export/*.docx

# 部署私钥（绝不提交）
.deploy/

# 抓取工具/浏览器会话的临时中间产物
_*.txt
.playwright-mcp/

# LaTeX 编译中间产物（论文.tex 经 xelatex 运行生成，不入库）
paper/export/pandoc/*.aux
paper/export/pandoc/*.log
paper/export/pandoc/论文.pdf
paper/export/pandoc/*.synctex*
*.synctex*

